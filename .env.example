# ============================================================
# REQUIRED — private area authentication
# ============================================================
# The password for "The Real Me" private area.
# Choose something long and unique. It is compared server-side only
# and is NEVER sent to the browser.
PRIVATE_AREA_PASSWORD=

# ============================================================
# REQUIRED — session signing secret
# ============================================================
# Signs the httpOnly session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ============================================================
# RECOMMENDED — canonical site URL
# ============================================================
# Used for SEO metadata and Open Graph tags. No trailing slash.
# Example (local):  http://localhost:3000
# Example (live):   https://yourdomain.com
SITE_URL=http://localhost:3000
